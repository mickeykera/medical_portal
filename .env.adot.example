# =============================================================================
# Adot Internal Medicine (Adot-Hospital) - On-Premises Environment Configuration
# Reference: docs/tenants/Adot-Hospital/handover.md
# Note: Per security policy, placeholder passwords are prohibited in production.
# =============================================================================

# Server Environment
ASPNETCORE_ENVIRONMENT=Production
HOSPITAL_HOST_DOMAIN=portal.adot.et

# PostgreSQL Dedicated Database Passwords
ADOT_POSTGRES_ROOT_PASSWORD=replace_with_strong_pg_root_secret
ADOT_PORTAL_DB_PASSWORD=replace_with_strong_portal_db_secret
ADOT_OPENMRS_DB_PASSWORD=replace_with_strong_openmrs_db_secret

# Authentication & Cryptographic Keys (Must be >= 256 bits / 32 bytes)
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_cryptographically_secure_base64_jwt_secret

# Authenticated Field Encryption Master Key (64 hex characters = 256-bit AES key)
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY_HEX=replace_with_64_hex_character_master_encryption_key

# Hospital Information Management System (HMS) Integration
HMS_BASE_URL=https://hms.adot.et/api
HMS_WEBHOOK_SECRET=replace_with_strong_hms_webhook_signing_secret

# National Health Interoperability (eCHIS, DHIS2 HMIS, MFR)
DHIS2_BASE_URL=https://dhis2.moh.gov.et
DHIS2_API_TOKEN=replace_with_woreda_dhis2_api_token
ECHIS_API_KEY=replace_with_echis_community_api_key

# Telebirr / Local Payment Gateway (Optional)
PAYMENT_GATEWAY_API_KEY=replace_with_telebirr_cbe_api_key
