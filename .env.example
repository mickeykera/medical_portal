# =============================================================================
# Medical Portal - Environment Variables Template (.env.example)
# Copy this file to .env before starting containers:
#   cp .env.example .env
#
# Profiles:
#   - Development: COMPOSE_PROFILES=dev (enables fake providers explicitly)
#   - Production:  COMPOSE_PROFILES=cluster (enforces real secrets & fail-closed)
# =============================================================================

# Active docker-compose profile: 'dev' (single-instance) or 'cluster' (multi-instance production)
COMPOSE_PROFILES=dev

# -----------------------------------------------------------------------------
# Security & Cryptographic Keys (Required in Production; Min 32 chars / 256 bits)
# -----------------------------------------------------------------------------
JWT_SECRET=

# -----------------------------------------------------------------------------
# Stripe Payment Gateway (Required in Production; format: sk_live_... or sk_test_...)
# In Development profile, STRIPE_USE_FAKE=true enables FakePaymentGateway explicitly.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_USE_FAKE=true

# -----------------------------------------------------------------------------
# Hospital Information Management System (HMS) Integration
# Required in Production; External URLs must use https://
# In Development profile, HMS_USE_FAKE=true enables FakeHmsClient explicitly.
# -----------------------------------------------------------------------------
HMS_WEBHOOK_SECRET=
HMS_BASE_URL=
HMS_USE_FAKE=true
